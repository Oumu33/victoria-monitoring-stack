# 复制为 .env 后按需修改：cp .env.example .env

# VictoriaMetrics 数据保留时长（数字=月，也支持 30d / 1y 这类写法）
VM_RETENTION_PERIOD=12

# Grafana 管理员账号（首次启动生效）
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin123

# 告警 Webhook 地址：alertmanager 会把告警 POST 到这里
# 直连飞书/钉钉需要一次格式转换，推荐用 prometheus-webhook-dingtalk 这类网关，
# 把网关地址填这里即可。留空则告警只进 alertmanager UI（:9093）
ALERT_WEBHOOK_URL=
